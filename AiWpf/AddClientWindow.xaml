<Window x:Class="AiWpf.AddClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Client" Height="500" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Add New Client" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Label Content="Client Code:" FontWeight="Bold"/>
                <TextBox x:Name="ClientCodeTextBox" Margin="0,0,0,10"/>

                <Label Content="Client Name:" FontWeight="Bold"/>
                <TextBox x:Name="ClientNameTextBox" Margin="0,0,0,10"/>

                <Label Content="Address:" FontWeight="Bold"/>
                <TextBox x:Name="AddressTextBox" Margin="0,0,0,10"/>

                <Label Content="Postal Code:" FontWeight="Bold"/>
                <TextBox x:Name="PostalCodeTextBox" Margin="0,0,0,10"/>

                <Label Content="City:" FontWeight="Bold"/>
                <TextBox x:Name="CityTextBox" Margin="0,0,0,10"/>

                <Label Content="Country:" FontWeight="Bold"/>
                <TextBox x:Name="CountryTextBox" Margin="0,0,0,10"/>

                <Label Content="Email:" FontWeight="Bold"/>
                <TextBox x:Name="EmailTextBox" Margin="0,0,0,10"/>

                <Label Content="Phone:" FontWeight="Bold"/>
                <TextBox x:Name="PhoneTextBox" Margin="0,0,0,10"/>

                <Label Content="Rate ES001:" FontWeight="Bold"/>
                <TextBox x:Name="RateES001TextBox" Margin="0,0,0,10"/>

                <Label Content="Rate AS001:" FontWeight="Bold"/>
                <TextBox x:Name="RateAS001TextBox" Margin="0,0,0,10"/>

                <Label Content="Retainer ES001:" FontWeight="Bold"/>
                <TextBox x:Name="RetainerES001TextBox" Margin="0,0,0,10"/>

                <Label Content="Retainer AS001:" FontWeight="Bold"/>
                <TextBox x:Name="RetainerAS001TextBox" Margin="0,0,0,10"/>

                <Label Content="Report Type:" FontWeight="Bold"/>
                <TextBox x:Name="ReportTypeTextBox" Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" Width="80" Height="30" Margin="0,0,10,0" Click="SaveButton_Click"/>
            <Button Content="Cancel" Width="80" Height="30" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>