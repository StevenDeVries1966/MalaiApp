<Window x:Class="AiWpf.Views.MainWindow"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
     xmlns:viewModels="clr-namespace:AiWpf.ViewModels"
        xmlns:views="clr-namespace:AiWpf.Views"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Worked Hours" Height="600" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
 <!-- Null to Visibility Converters -->
        <views:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <views:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
    </Window.Resources>

    <Window.DataContext>
        <viewModels:MainWindowViewModel />
 </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
 <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- Filter Panel -->
        <GroupBox Grid.Row="0" Header="Filters" Padding="10" Margin="0,0,0,10">
   <Grid>
                <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="150"/>
 <ColumnDefinition Width="20"/>
     <ColumnDefinition Width="Auto"/>
           <ColumnDefinition Width="150"/>
      <ColumnDefinition Width="20"/>
          <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="250"/>
     </Grid.ColumnDefinitions>

  <TextBlock Grid.Column="0" Text="Month:" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <ComboBox Grid.Column="1" 
     SelectedItem="{Binding Month, UpdateSourceTrigger=PropertyChanged}"
          ItemsSource="{Binding Months}"
  VerticalAlignment="Center"/>

       <TextBlock Grid.Column="3" Text="Year:" VerticalAlignment="Center" Margin="0,0,10,0"/>
     <ComboBox Grid.Column="4" 
            SelectedItem="{Binding Year, UpdateSourceTrigger=PropertyChanged}"
     ItemsSource="{Binding Years}"
       VerticalAlignment="Center"/>

          <TextBlock Grid.Column="6" Text="Client Code:" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <ComboBox Grid.Column="7" 
             SelectedValuePath="clt_code"
           DisplayMemberPath="DisplayName"
     SelectedValue="{Binding ClientCode, UpdateSourceTrigger=PropertyChanged}"
    ItemsSource="{Binding Clients}"
           VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- Main Content Area with DataGrid and Details Panel -->
   <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="5"/>
         <ColumnDefinition Width="350"/>
   </Grid.ColumnDefinitions>

            <!-- DataGrid -->
            <DataGrid Grid.Column="0"
     ItemsSource="{Binding WorkedHours}"
        SelectedItem="{Binding SelectedWorkedHour}"
 AutoGenerateColumns="False"
 CanUserAddRows="False"
   IsReadOnly="True"
                AlternatingRowBackground="LightGray"
     GridLinesVisibility="Horizontal"
        HorizontalGridLinesBrush="DarkGray">
  <DataGrid.Columns>
          <DataGridTextColumn Header="Entry ID" Binding="{Binding entry_id}" Width="80"/>
       <DataGridTextColumn Header="Employee Code" Binding="{Binding emp_code}" Width="120"/>
           <DataGridTextColumn Header="Client Code" Binding="{Binding clt_code}" Width="100"/>
  <DataGridTextColumn Header="Job Code" Binding="{Binding clt_job_code}" Width="100"/>
         <DataGridTextColumn Header="Job Name" Binding="{Binding job_name}" Width="150"/>
         <DataGridTextColumn Header="Date" Binding="{Binding date_display}" Width="100"/>
         <DataGridTextColumn Header="Start Time" Binding="{Binding start_time, StringFormat='HH:mm'}" Width="100"/>
        <DataGridTextColumn Header="End Time" Binding="{Binding end_time, StringFormat='HH:mm'}" Width="100"/>
         <DataGridTextColumn Header="Hours Worked" Binding="{Binding hours_worked_display}" Width="120"/>
    </DataGrid.Columns>
            </DataGrid>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1" 
         Width="5" 
     HorizontalAlignment="Stretch" 
   VerticalAlignment="Stretch"
            Background="LightGray"/>

    <!-- Details Panel -->
     <GroupBox Grid.Column="2" Header="Details" Padding="10">
           <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel DataContext="{Binding SelectedWorkedHour}">
           <StackPanel.Resources>
           <Style TargetType="TextBlock" x:Key="LabelStyle">
        <Setter Property="FontWeight" Value="Bold"/>
          <Setter Property="Margin" Value="0,5,0,2"/>
        </Style>
           <Style TargetType="TextBox">
       <Setter Property="IsReadOnly" Value="True"/>
   <Setter Property="Background" Value="WhiteSmoke"/>
       <Setter Property="Margin" Value="0,0,0,5"/>
   <Setter Property="Padding" Value="5"/>
      </Style>
         </StackPanel.Resources>

    <!-- Show message when no row is selected -->
           <TextBlock Text="No record selected" 
  FontStyle="Italic" 
        Foreground="Gray"
   HorizontalAlignment="Center"
      Margin="0,20,0,0"
  Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}"/>

       <!-- Details fields - only visible when a row is selected -->
     <StackPanel Visibility="{Binding Converter={StaticResource NotNullToVisibilityConverter}}">
          
       <TextBlock Text="Employee Code:" Style="{StaticResource LabelStyle}"/>
       <TextBox Text="{Binding emp_code, Mode=OneWay}"/>

          <TextBlock Text="Client Code:" Style="{StaticResource LabelStyle}"/>
    <TextBox Text="{Binding clt_code, Mode=OneWay}"/>

        <TextBlock Text="Client Job Code:" Style="{StaticResource LabelStyle}"/>
      <TextBox Text="{Binding clt_job_code, Mode=OneWay}"/>

<TextBlock Text="Job Name:" Style="{StaticResource LabelStyle}"/>
         <TextBox Text="{Binding job_name, Mode=OneWay}"/>

    <TextBlock Text="Week:" Style="{StaticResource LabelStyle}"/>
         <TextBox Text="{Binding week, Mode=OneWay}"/>

     <TextBlock Text="Month:" Style="{StaticResource LabelStyle}"/>
           <TextBox Text="{Binding month, Mode=OneWay}"/>

      <TextBlock Text="Year:" Style="{StaticResource LabelStyle}"/>
    <TextBox Text="{Binding year, Mode=OneWay}"/>

          <TextBlock Text="Date:" Style="{StaticResource LabelStyle}"/>
     <TextBox Text="{Binding date_display, Mode=OneWay}"/>

     <TextBlock Text="Start Time:" Style="{StaticResource LabelStyle}"/>
     <TextBox Text="{Binding start_time, StringFormat='yyyy-MM-dd HH:mm:ss', Mode=OneWay}"/>

      <TextBlock Text="End Time:" Style="{StaticResource LabelStyle}"/>
      <TextBox Text="{Binding end_time, StringFormat='yyyy-MM-dd HH:mm:ss', Mode=OneWay}"/>

          <TextBlock Text="Hours Worked:" Style="{StaticResource LabelStyle}"/>
           <TextBox Text="{Binding hours_worked_display, Mode=OneWay}"/>

    <TextBlock Text="Minutes Worked:" Style="{StaticResource LabelStyle}"/>
      <TextBox Text="{Binding minutes_worked_display, Mode=OneWay}"/>

     <TextBlock Text="Notes:" Style="{StaticResource LabelStyle}"/>
       <TextBox Text="{Binding notes, Mode=OneWay}" 
       TextWrapping="Wrap" 
         MinHeight="60" 
     AcceptsReturn="True"/>
    </StackPanel>
      </StackPanel>
        </ScrollViewer>
  </GroupBox>
        </Grid>

  <!-- Status Bar -->
  <StatusBar Grid.Row="2" Margin="0,10,0,0">
      <StatusBarItem>
         <TextBlock>
              <Run Text="Total Records: "/>
       <Run Text="{Binding WorkedHours.Count, Mode=OneWay}"/>
         </TextBlock>
       </StatusBarItem>
     <Separator/>
            <StatusBarItem>
           <TextBlock Text="{Binding SelectedWorkedHour.emp_code, StringFormat='Selected Employee: {0}', FallbackValue='No selection'}"/>
            </StatusBarItem>
   </StatusBar>
    </Grid>
</Window>
