<Window x:Class="AiWpf.DtoClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DtoClient Viewer" Height="600" Width="1200"
        WindowStartupLocation="CenterScreen">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		
		<TextBlock Grid.Row="0" Text="Client Data" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
		
		<DataGrid x:Name="DtoClientGrid" 
				  Grid.Row="1"
				  AutoGenerateColumns="True"
				  IsReadOnly="True"
				  AlternatingRowBackground="LightGray"
				  GridLinesVisibility="Horizontal"
				  HeadersVisibility="Column"
				  CanUserAddRows="False"
				  CanUserDeleteRows="False"
				  CanUserResizeColumns="True"
				  CanUserSortColumns="True" />
		
		<StatusBar Grid.Row="2" Margin="0,10,0,0">
			<StatusBarItem x:Name="StatusBarText" Content="Loading client data..."/>
		</StatusBar>
	</Grid>
</Window>